# Generated. `npm start` / `npm run bundle` rebuilds it from src/.
# Tracking it is what let the shipped app drift ahead of src/.
electron/app/CNCStudio.html

# Installer output - rebuilt by `npm run build`
dist/
electron/dist/

*.log

# Everything else in this repo is tracked on purpose, including the reference
# TAP and DXF files in tapfiles/, the Nirmala fonts the Text box loads, the
# scenario screenshots and the operator's reference images. They are the
# material this app is checked against, and a clone of this repo is meant to be
# the whole job - nothing left behind on one PC.

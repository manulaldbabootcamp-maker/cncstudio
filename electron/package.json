{
  "name": "cnc-studio",
  "version": "0.1.0",
  "description": "2D CAD/CAM for WinCNC — EnRoute replacement",
  "main": "main.js",
  "scripts": {
    "start": "node ../build.js && electron .",
    "dev": "node ../build.js && electron .",
    "bundle": "node ../build.js",
    "test": "node ../test/verify.js",
    "build": "node ../build.js && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.manav.cncstudio",
    "productName": "CNC Studio",
    "files": [
      "main.js",
      "app/**"
    ],
    "win": {
      "target": "portable"
    }
  }
}
